<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PlayniteCmdPal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\PlayniteCmdPal-Brand-Assets\icons\ico\PlayniteCmdPal.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WindowsSdkPackageVersion>10.0.26100.84</WindowsSdkPackageVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- The Command Palette SDK WinMD is an interface contract, not a runtime component.
         Keep the metadata in the package but do not harvest nonexistent WinRT class
         implementations into the app manifest. The COM server is declared explicitly
         in Package.appxmanifest. -->
    <AppxHarvestWinmdRegistration>false</AppxHarvestWinmdRegistration>
    <AppxPackageIdentityName>werdscopez7347.PlayniteforCommandPalette</AppxPackageIdentityName>
    <AppxPackagePublisher>CN=B5EE8A57-B227-4726-A4E9-AF40E9D47E70</AppxPackagePublisher>
    <AppxPackageVersion>0.0.8.0</AppxPackageVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Third-party notices and the retained PowerToys template license travel with the
         published package. See docs/LICENSING-AND-RELEASE.md. -->
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\third-party\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\third-party\Microsoft-PowerToys-LICENSE.txt" Link="Microsoft-PowerToys-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Shmuelie.WinRTServer" />

    <!-- Needed to enable building an MSIX package -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>

    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Suppress DynamicallyAccessedMemberTypes.PublicParameterlessConstructor in fallback code path of Windows SDK projection -->
    <WarningsNotAsErrors>IL2081;$(WarningsNotAsErrors)</WarningsNotAsErrors>

    <!-- When publishing trimmed, make sure to treat trimming warnings as build errors -->
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <!-- In Debug builds, trimming is disabled by default, but all the trim & 
         AOT warnings are enabled. This gives debug builds a tighter inner loop,
         while at least warning about future trim violations -->
    <PublishTrimmed>false</PublishTrimmed>
    
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <!-- Preserve the Windows SDK projection assemblies exactly as supplied by the
         REDIST-listed net8.0 targeting-pack assets. Do not trim or transform them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>


  <!-- Self-contained publishes must carry the notices from the .NET runtime pack restored. -->
  <Target Name="CopyDotNetRuntimeThirdPartyNotices"
          AfterTargets="Publish"
          Condition="'$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- Match only Microsoft.NETCore.App.Runtime, not the Windows Desktop, ASP.NET Core,
           or Windows SDK reference packs that may also appear in ResolvedRuntimePack. -->
      <_DotNetRuntimeNoticeFiles Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\*\THIRD-PARTY-NOTICES.TXT" />
    </ItemGroup>

    <Error Condition="'@(_DotNetRuntimeNoticeFiles)' == ''"
           Text="The .NET runtime third-party notices were not found for $(RuntimeIdentifier). Do not distribute this self-contained publish without the notices." />
    <Error Condition="'@(_DotNetRuntimeNoticeFiles->Count())' != '1'"
           Text="Expected exactly one Microsoft.NETCore.App runtime third-party notices file for $(RuntimeIdentifier), found: @(_DotNetRuntimeNoticeFiles)." />

    <Copy SourceFiles="@(_DotNetRuntimeNoticeFiles)"
          DestinationFiles="$(PublishDir)dotnet-runtime-THIRD-PARTY-NOTICES.txt" />
  </Target>

  <!-- The runtime notice is created during Publish, after the MSIX packaging pipeline
       has already collected its normal payload. Add the exact restored runtime-pack
       notice directly to AppxPackagePayload immediately before MakeAppx consumes it. -->
  <Target Name="AddDotNetRuntimeThirdPartyNoticesToMsixPayload"
          BeforeTargets="_GenerateAppxPackageFile"
          Condition="'$(AppxPackage)' == 'true' and '$(SelfContained)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_DotNetRuntimeMsixNoticeFiles Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier)\*\THIRD-PARTY-NOTICES.TXT" />
    </ItemGroup>

    <Error Condition="'@(_DotNetRuntimeMsixNoticeFiles)' == ''"
           Text="The .NET runtime third-party notices were not found for $(RuntimeIdentifier). Do not create a self-contained MSIX without the notices." />
    <Error Condition="'@(_DotNetRuntimeMsixNoticeFiles->Count())' != '1'"
           Text="Expected exactly one Microsoft.NETCore.App runtime third-party notices file for $(RuntimeIdentifier), found: @(_DotNetRuntimeMsixNoticeFiles)." />

    <ItemGroup>
      <AppxPackagePayload Include="@(_DotNetRuntimeMsixNoticeFiles)">
        <TargetPath>dotnet-runtime-THIRD-PARTY-NOTICES.txt</TargetPath>
      </AppxPackagePayload>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PlayniteCmdPal.Core\PlayniteCmdPal.Core.csproj" />
    <ProjectReference Include="..\PlayniteCmdPal.Playnite\PlayniteCmdPal.Playnite.csproj" />
  </ItemGroup>
</Project>
